<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>embedded</DebugType>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <PublishDir>$(MSBuildProjectDirectory)/../../artifacts/wpf-release/win-x64/</PublishDir>
  </PropertyGroup>

  <Target Name="RemoveDllRelayConfigFromSingleFilePublish"
          AfterTargets="ComputeResolvedFilesToPublishList">
    <!-- DLL中継の設定は配布スクリプトが dll-relay に配置します。 -->
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                             Condition="'%(ResolvedFileToPublish.RelativePath)' == 'UWSCSharp.DllRelay.deps.json' or
                                        '%(ResolvedFileToPublish.RelativePath)' == 'UWSCSharp.DllRelay.runtimeconfig.json'" />
    </ItemGroup>
  </Target>
</Project>
