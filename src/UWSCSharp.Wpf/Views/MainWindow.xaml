<Window x:Class="UWSCSharp.Wpf.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="UWSC#（記録・一時停止 試作版）" Width="620" SizeToContent="Height" ResizeMode="CanMinimize"
    Background="#F0F0F0" Closing="WindowClosing" PreviewKeyDown="HelpPreviewKeyDown"
    Icon="/Assets/UWSCSharp.ico" AllowDrop="True"
    PreviewDragEnter="ScriptDragOver" PreviewDragOver="ScriptDragOver" PreviewDrop="ScriptDrop">
    <StackPanel Margin="8">
        <WrapPanel>
            <Button x:Name="LoadButton" Content="📂 読込" Click="LoadClick" Padding="10,7" Margin="2" />
            <Button x:Name="SaveButton" Content="▣ 保存" Click="SaveClick" Padding="10,7" Margin="2" />
            <Button x:Name="PlayButton" Content="▶ 再生" Click="PlayClick" Padding="10,7" Margin="2" />
            <Button x:Name="StopButton" Content="■ 停止" Click="StopClick" IsEnabled="False" Padding="10,7" Margin="2" />
            <Button x:Name="RecordButton" Content="● 記録" Click="RecordClick" ToolTip="F8: 記録開始・終了（基本記録の試作）" Padding="10,7" Margin="2" />
            <Button x:Name="PauseButton" Content="Ⅱ 一時停止" Click="PauseClick" IsEnabled="False" ToolTip="F9: 一時停止・再開 / F10: 停止。押下中のキー・ボタンはUPまで一時停止を保留します" Padding="10,7" Margin="2" />
        </WrapPanel>
        <WrapPanel>
            <Button x:Name="TrayButton" Content="トレイに格納" Click="TrayClick" Padding="6" Margin="2"
                ToolTip="通知領域に格納します。アイコンのダブルクリック、または右クリックの「開く」で戻ります" />
            <Button x:Name="SettingsButton" Content="ホットキー設定" Click="SettingsClick" Padding="6" Margin="2" />
            <Button x:Name="LogSettingsButton" Content="ログ設定" Click="LogSettingsClick" Padding="6" Margin="2" />
            <Button x:Name="WindowSettingsButton" Content="本体設定" Click="WindowSettingsClick" Padding="6" Margin="2" />
            <Button x:Name="AssociationButton" Content="関連付け" Click="AssociationClick" Padding="6" Margin="2" />
            <Button x:Name="LauncherButton" Content="ランチ" Click="LauncherClick" Padding="6" Margin="2"
                ToolTip="登録した項目を起動します。登録の編集は再生・記録の停止中に行えます。" />
            <Button x:Name="HelpButton" Content="ヘルプ" Click="HelpClick" Padding="6" Margin="2"
                AutomationProperties.AcceleratorKey="F1" ToolTip="F1: 同梱ヘルプをブラウザーで表示（再生・記録の停止中）" />
            <Button x:Name="InputCleanupButton" Content="入力フックを再回収" Click="InputCleanupClick"
                IsEnabled="False" Padding="6" Margin="2"
                ToolTip="終了した実行の入力禁止フックの未回収所有者へ、明示的な再回収を1回要求します" />
        </WrapPanel>
        <WrapPanel x:Name="SchedulerPanel" Visibility="Collapsed" Margin="2">
            <Button x:Name="SchedulerSettingsButton" Content="予約設定…" Click="SchedulerSettingsClick" Padding="6" Margin="2" />
            <Button x:Name="SchedulerMonitorButton" Content="予約監視を開始" Click="SchedulerMonitorClick"
                Padding="6" Margin="2" ToolTip="有効な予約設定の監視を開始します。他の本体が監視中の場合は取得しません。" />
            <TextBlock x:Name="SchedulerStatus" Margin="4" VerticalAlignment="Center" TextWrapping="Wrap"
                AutomationProperties.LiveSetting="Polite" />
        </WrapPanel>
        <CheckBox x:Name="OmitIdleRecordingCheckBox"
            Click="RecordingSettingsClick"
            Content="余分な時間、マウス移動は記録しない" Margin="4,6"
            ToolTip="SLEEPと、ボタンを押していない間のMMVを省略します。クリックの座標とドラッグ中の移動は記録します。記録開始時の設定を使用します。" />
        <CheckBox x:Name="RelativeMouseRecordingCheckBox"
            Content="マウス座標を相対座標で記録する" Margin="4,6"
            Click="RecordingSettingsClick"
            ToolTip="アクティブウインドウの左上（枠を含む）を基準に、ACWとSTATUSの座標式で記録します。記録開始時の設定を使用します。" />
        <CheckBox x:Name="HighLevelRecordingCheckBox"
            Content="高レベル記録（Win32ボタン）" Margin="4,6"
            Click="RecordingSettingsClick"
            ToolTip="対象の左クリックをCLKITEMで記録します。記録開始時の設定を使用します。" />
        <CheckBox x:Name="BackgroundRecordingCheckBox"
            Content="背景再生用に記録する（Win32ボタン）" Margin="4,6"
            Click="RecordingSettingsClick"
            ToolTip="対象を前面に出さずに再生できるCLKITEMを生成します。" />
        <CheckBox x:Name="CopyRecordingCheckBox"
            Content="記録後クリップボードへコピーする" Margin="4,6"
            Click="RecordingSettingsClick"
            ToolTip="正常に開始した記録を停止操作で終了した場合だけコピーします。警告・上限超過・画面終了時の回収は除外します。" />
        <TextBlock x:Name="FileLabel" Text="新規スクリプト（保存はUTF-8 BOM付き）" Margin="4" TextTrimming="CharacterEllipsis" />
        <TextBlock x:Name="StatusLabel" Text="待機中" Margin="4" AutomationProperties.LiveSetting="Polite" />
        <TextBlock x:Name="InputCleanupLabel" Margin="4" TextWrapping="Wrap" Visibility="Collapsed"
            AutomationProperties.LiveSetting="Polite" />
        <TextBlock x:Name="HotkeyLabel" Margin="4" TextWrapping="Wrap" />
        <TextBlock x:Name="LauncherNotice" Margin="4" TextWrapping="Wrap"
            AutomationProperties.LiveSetting="Polite" />
        <TextBlock x:Name="LauncherHotkeyNotice" Margin="4" TextWrapping="Wrap" Visibility="Collapsed"
            AutomationProperties.LiveSetting="Polite" />
        <Expander x:Name="EditorPanel" Header="スクリプト編集・実行結果" Margin="2">
            <StackPanel>
                <TextBox x:Name="Editor" Height="260" AcceptsReturn="True" AcceptsTab="True"
                    FontFamily="Consolas" FontSize="14" VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Auto" TextChanged="EditorChanged"
                    AutomationProperties.Name="スクリプト編集" />
                <TextBlock Text="実行結果" Margin="0,8,0,4" />
                <TextBox x:Name="Output" Height="130" IsReadOnly="True" IsUndoEnabled="False"
                    FontFamily="Consolas"
                    VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                    AutomationProperties.Name="実行結果" />
            </StackPanel>
        </Expander>
    </StackPanel>
</Window>
