# Reference: https://github.com/dotnet/wpf/blob/main/.gitattributes
# Match .editorconfig; normalize text in Git and check it out with LF.
* text=auto eol=lf

# C# source and WPF/MSBuild text formats.
*.cs text diff=csharp
*.xaml text
*.csproj text
*.props text
*.targets text
*.slnx text
*.resx text

# Legacy Visual Studio solutions and Windows command scripts use CRLF.
*.sln text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf
*.sh text eol=lf

# Preserve original bytes in UWSC compatibility samples.
*.uws -text !eol


# WPF and test assets are binary.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.bmp binary
*.tif binary
*.tiff binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.exe binary
*.dll binary
*.pdb binary
*.baml binary
*.resources binary
*.zip binary
*.7z binary
*.gz binary
*.pdf binary
