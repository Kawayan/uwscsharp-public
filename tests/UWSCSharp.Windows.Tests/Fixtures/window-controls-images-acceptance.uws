// 専用fixtureのHWND、検索BMP、保存BMPをPARAM_STRで渡して実行します。
// 実アプリや実画面を対象にした受入スクリプトではありません。
id = HNDTOID(VAL(PARAM_STR[0]))
PRINT GETSTR(id, 1, STR_EDIT)
PRINT CLKITEM(id, "確認", CLK_BTN)
PRINT CHKBTN(id, "確認")
PRINT POSACC(id, 15, 15, ACC_NAME OR ACC_BACK)
PRINT SETSLIDER(id, 42)
PRINT GETSLIDER(id)
PRINT CLKITEM(id, "Beta", CLK_LIST)
PRINT GETSLCTLST(id)
FOR item IN GETITEM(id, ITM_BTN OR ITM_LIST OR ITM_MENU OR ITM_EDIT OR ITM_STATIC)
    PRINT item
NEXT
PRINT LENGTH(ALL_ITEM_LIST)
PRINT CLKITEM(id, "ファイル\実行", CLK_MENU OR CLK_BACK)
PRINT PEEKCOLOR(0, 0, COL_RGB)
PRINT CHKIMG(PARAM_STR[1], 0, 0, 0, 4, 2, -1)
PRINT G_IMG_X
PRINT G_IMG_Y
PRINT LENGTH(ALL_IMG_X)
SAVEIMG(PARAM_STR[2], 0, 0, 0, 2, 1)
PRINT CHKIMG(PARAM_STR[2], 0, 0, 0, 4, 2, 2)
PRINT G_IMG_X
PRINT G_IMG_Y
PRINT LENGTH(ALL_IMG_X)
PRINT CLKITEM(id, "missing", CLK_BTN)
